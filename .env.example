# Crie um arquivo .env.local para desenvolvimento local
# Crie um arquivo .env.production para fazer build de produção
VITE_BASE_URL=/analises/
VITE_API_URL=/analises/api/v1/

# funcionario
VITE_LOGIN_URL=/intranet/intranet/build/index.html#/funcionario

# docente/coordenador/funcionario
#VITE_LOGIN_URL=/intranet/intranet/build/index.html

# aluno
# VITE_LOGIN_URL=/Aol_Responsivo_Redirect/auth/login/index.php

# Dados simulados (MSW). true = o front roda inteiro com dados fictícios, sem backend
# (entrega atual: só o front). Com a API real no ar, o TI troca para false (docs/INTEGRACAO.md).
VITE_USE_MOCKS=true
