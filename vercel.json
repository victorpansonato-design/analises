{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "framework": "vite",
   "buildCommand": "VITE_BASE_URL=/ VITE_API_URL=/api/v1/ VITE_USE_MOCKS=true npm run build",
   "outputDirectory": "build",
   "rewrites": [{ "source": "/((?!assets/|mockServiceWorker\\.js|icone_header\\.png).*)", "destination": "/index.html" }]
}
